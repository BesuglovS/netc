<!-- Скопируйте в keystore.local.props и подставьте пароли хранилища/ключа.
     Файл keystore.local.props в .gitignore и НЕ попадает в репозиторий. -->
<Project>
  <PropertyGroup>
    <AndroidSigningStorePass>ЗАМЕНИТЕ-НА-ПАРОЛЬ-ХРАНИЛИЩА</AndroidSigningStorePass>
    <AndroidSigningKeyPass>ЗАМЕНИТЕ-НА-ПАРОЛЬ-КЛЮЧА</AndroidSigningKeyPass>
  </PropertyGroup>
</Project>
